# Copier ce fichier vers .env.local et renseigner les valeurs.
# Les clés sont à générer sur https://www.themoviedb.org/settings/api

# Clé API v3 TMDB
TMDB_API_KEY=

# Jeton d'accès v4 TMDB (recommandé, « API Read Access Token »)
TMDB_ACCESS_TOKEN=

# URL publique du site (optionnelle) : canonique, sitemap, images de partage.
# Par défaut : domaine de production Vercel, URL du déploiement en preview,
# http://localhost:3000 en développement.
NEXT_PUBLIC_SITE_URL=
